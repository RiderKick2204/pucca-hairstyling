---
const { title } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={Astro.props.description || "Pucca Hairstyling Salon"}
    />
    <title>{title} | Pucca Hairstyling</title>
    <link rel="icon" type="image/svg+xml" href="/hairstyling.svg" />
  </head>
  <body class="min-h-screen bg-gray-50 flex flex-col">
    <!-- Make the nav sticky with transition -->
    <nav
      id="navbar"
      class="bg-white shadow-md sticky top-0 z-40 transition-all duration-300"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="flex items-center">
              <span class="text-xl sm:text-2xl font-bold text-primary"
                >Pucca Hairstyling</span
              >
            </a>
          </div>

          <!-- Mobile menu button -->
          <div class="flex items-center md:hidden">
            <button
              type="button"
              id="mobile-menu-button"
              class="relative inline-flex items-center justify-center w-12 h-12 rounded-md text-gray-700 hover:text-primary hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary"
              aria-expanded="false"
            >
              <span class="menu-text absolute text-sm font-bold">MENU</span>
              <div class="menu-icon relative w-6 h-6 opacity-0">
                <span class="hamburger-line top-line"></span>
                <span class="hamburger-line middle-line"></span>
                <span class="hamburger-line bottom-line"></span>
              </div>
            </button>
          </div>

          <!-- Desktop menu -->
          <div class="hidden md:flex items-center space-x-4">
            <a href="/" class="text-gray-700 hover:text-primary px-3 py-2"
              >Home</a
            >
            <a
              href="/services"
              class="text-gray-700 hover:text-primary px-3 py-2">Services</a
            >
            <a
              href="/products"
              class="text-gray-700 hover:text-primary px-3 py-2">Products</a
            >
            <!-- <a href="/admin" class="text-gray-700 hover:text-primary px-3 py-2"
              >Admin</a
            > -->
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden h-0 transition-all duration-300 ease-in-out overflow-hidden md:hidden"
      >
        <div class="px-2 py-3 space-y-1">
          <a href="/" class="block px-3 py-2 text-gray-700 hover:text-primary"
            >Home</a
          >
          <a
            href="/services"
            class="block px-3 py-2 text-gray-700 hover:text-primary">Services</a
          >
          <a
            href="/products"
            class="block px-3 py-2 text-gray-700 hover:text-primary">Products</a
          >
          <!-- <a
            href="/admin"
            class="block px-3 py-2 text-gray-700 hover:text-primary">Admin</a
          > -->
        </div>
      </div>
    </nav>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-gray-800 text-white mt-12 md:mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-4">Contact Us</h3>
            <p>Email: info@puccahairstyling.com</p>
            <p>Phone: (123) 456-7890</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Business Hours</h3>
            <p>Monday - Saturday: 9:00 AM - 7:00 PM</p>
            <p>Sunday: Closed</p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Follow Us</h3>
            <div class="flex space-x-4">
              <a href="#" class="hover:text-primary">Instagram</a>
              <a href="#" class="hover:text-primary">Facebook</a>
            </div>
          </div>
        </div>
        <div class="mt-8 text-center border-t border-gray-700 pt-8">
          <p>
            &copy; {new Date().getFullYear()} Pucca Hairstyling. All rights reserved.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Style for when navbar is in sticky scrolled state */
  .navbar-scrolled {
    @apply bg-white/90 backdrop-blur-sm shadow-md;
  }

  /* Hamburger menu icon styles */
  .hamburger-line {
    @apply absolute left-0 block h-0.5 w-6 transform bg-current transition duration-500 ease-in-out;
  }

  .top-line {
    @apply top-0;
  }

  .middle-line {
    @apply top-[10px];
  }

  .bottom-line {
    @apply top-[20px];
  }

  /* Animation classes */
  .menu-open .top-line {
    @apply top-[10px] rotate-45;
  }

  .menu-open .middle-line {
    @apply opacity-0;
  }

  .menu-open .bottom-line {
    @apply top-[10px] -rotate-45;
  }

  /* Mobile menu animation */
  .slide-enter {
    @apply block;
    height: 0;
  }

  .slide-enter-active {
    height: var(--menu-height);
  }

  .slide-exit {
    height: var(--menu-height);
  }

  .slide-exit-active {
    height: 0;
  }

  /* Menu button states */
  .menu-text {
    @apply transition-opacity duration-500 ease-in-out;
  }

  .menu-icon {
    @apply transition-opacity duration-500 ease-in-out;
  }

  .menu-open .menu-text {
    @apply opacity-0;
  }

  .menu-open .menu-icon {
    @apply opacity-100;
  }

  /* Update hamburger line styles to be relative to menu-icon */
  .hamburger-line {
    @apply absolute left-0 block h-0.5 w-6 transform bg-current transition duration-500 ease-in-out;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const navbar = document.getElementById("navbar");
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuContent = mobileMenu?.querySelector("div");

    // Mobile menu toggle with animation
    mobileMenuButton?.addEventListener("click", () => {
      if (!mobileMenu || !menuContent) return;

      // Toggle the menu-open class on the button itself
      mobileMenuButton.classList.toggle("menu-open");

      const isHidden = mobileMenu.classList.contains("hidden");

      if (isHidden) {
        // Opening menu
        mobileMenu.classList.remove("hidden");
        // Set the height variable for animation
        const height = menuContent.getBoundingClientRect().height;
        mobileMenu.style.setProperty("--menu-height", `${height}px`);
        // Trigger animation
        requestAnimationFrame(() => {
          mobileMenu.classList.add("slide-enter-active");
        });
      } else {
        // Closing menu
        mobileMenu.classList.remove("slide-enter-active");
        // Add transition end listener to hide menu
        const hideMenu = () => {
          mobileMenu.classList.add("hidden");
          mobileMenu.removeEventListener("transitionend", hideMenu);
        };
        mobileMenu.addEventListener("transitionend", hideMenu);
      }

      // Toggle hamburger icon
      mobileMenuButton.firstElementChild?.nextElementSibling?.classList.toggle(
        "menu-open",
      );
      const isExpanded =
        mobileMenuButton.getAttribute("aria-expanded") === "true";
      mobileMenuButton.setAttribute("aria-expanded", (!isExpanded).toString());
    });

    // Navbar scroll effect
    window.addEventListener("scroll", () => {
      if (window.scrollY > 20) {
        navbar?.classList.add("navbar-scrolled");
      } else {
        navbar?.classList.remove("navbar-scrolled");
      }
    });
  });
</script>
