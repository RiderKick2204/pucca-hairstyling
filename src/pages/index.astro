---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout
  title="Welcome"
  description="Experience the art of beautiful hair with Pucca Hairstyling. Book professional haircuts, styling, color, highlights, and hair treatments in our salon."
>
  <div class="text-black">
    <div class="relative">
      <Image
        src="/banner.png"
        alt="Hair salon banner"
        loading="eager"
        width={1280}
        height={720}
        class={"w-full h-[300px] sm:h-[350px] md:h-[400px] object-cover"}
      />
      <div
        class="absolute inset-0 flex items-center justify-center w-full px-4"
      >
        <div
          class="w-full max-w-screen-md mx-auto px-3 sm:px-6 py-8 sm:py-12 md:py-16 bg-white bg-opacity-80 rounded-lg"
        >
          <div class="text-center rounded-lg px-2 sm:px-6 mx-auto">
            <h1
              class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-2 sm:mb-4 md:mb-6 bg-gradient-to-r from-primary to-purple-600 text-transparent bg-clip-text py-1 sm:py-2"
            >
              Welcome to Pucca Hairstyling
            </h1>
            <p
              class="text-sm sm:text-lg md:text-xl mb-4 sm:mb-6 md:mb-8 text-black"
            >
              Experience the art of beautiful hair with our professional styling
              services
            </p>
            <a
              href="/services"
              class="btn bg-white text-primary hover:bg-gray-100 text-xs sm:text-sm md:text-base border px-4 py-2"
              >Book Now</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <h2 class="text-center text-2xl sm:text-3xl mb-8 sm:mb-12">
      Our Featured Services
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h3>Haircut & Styling</h3>
        <p class="text-gray-600 mb-4">
          Professional haircuts and styling services tailored to your
          preferences
        </p>
        <a href="/services" class="text-primary hover:text-opacity-80"
          >Learn More →</a
        >
      </div>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h3>Color & Highlights</h3>
        <p class="text-gray-600 mb-4">
          Transform your look with our expert coloring and highlighting services
        </p>
        <a href="/services" class="text-primary hover:text-opacity-80"
          >Learn More →</a
        >
      </div>
      <div class="bg-white p-6 rounded-lg shadow-md">
        <h3>Hair Treatments</h3>
        <p class="text-gray-600 mb-4">
          Revitalize your hair with our premium treatment services
        </p>
        <a href="/services" class="text-primary hover:text-opacity-80"
          >Learn More →</a
        >
      </div>
    </div>
  </div>

  <div class="bg-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <h2 class="text-center text-2xl sm:text-3xl mb-8 sm:mb-12">
        Why Choose Us?
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 sm:gap-8 text-center">
        <div>
          <div class="text-4xl text-primary mb-4">10+</div>
          <p class="font-semibold">Years Experience</p>
        </div>
        <div>
          <div class="text-4xl text-primary mb-4">1000+</div>
          <p class="font-semibold">Happy Clients</p>
        </div>
        <div>
          <div class="text-4xl text-primary mb-4">50+</div>
          <p class="font-semibold">Hair Products</p>
        </div>
        <div>
          <div class="text-4xl text-primary mb-4">100%</div>
          <p class="font-semibold">Satisfaction</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
